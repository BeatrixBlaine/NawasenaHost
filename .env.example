# Copy to .env, or run ./scripts/generate-env.sh to fill everything with fresh secrets.
TAG=latest
HTTP_PORT=80

MYSQL_ROOT_PASSWORD=change-me

# Base64 string, at least 32 bytes:  openssl rand -base64 48
JWT_SECRET=
# RSA key pair for service tokens, Base64 DER, the same for every auth-service replica
JWT_RSA_PRIVATE_KEY=
JWT_RSA_PUBLIC_KEY=

# first system ADMIN, created on the first start of auth-service
NAWASENAHOST_ADMIN_USERNAME=admin
NAWASENAHOST_ADMIN_PASSWORD=change-me
NAWASENAHOST_ADMIN_EMAIL=admin@example.com

# first MANAGER of hotel NAWASENAHOST_MANAGER_HOTEL_ID
NAWASENAHOST_MANAGER_USERNAME=manager
NAWASENAHOST_MANAGER_PASSWORD=change-me
NAWASENAHOST_MANAGER_EMAIL=manager@example.com
NAWASENAHOST_MANAGER_HOTEL_ID=1

# service client secrets: plain value for the service, BCrypt hash for auth-service
SERVICE_CLIENT_SECRET=
SERVICE_CLIENT_SECRET_BCRYPT=
PAYMENT_CLIENT_SECRET=
PAYMENT_CLIENT_SECRET_BCRYPT=
AVAILABILITY_CLIENT_SECRET=
AVAILABILITY_CLIENT_SECRET_BCRYPT=
ROOM_CLIENT_SECRET=
ROOM_CLIENT_SECRET_BCRYPT=
CUSTOMER_CLIENT_SECRET=
CUSTOMER_CLIENT_SECRET_BCRYPT=

API_GATEWAY_REPLICAS=2
ADMIN_PANEL_SERVICE_REPLICAS=2
AUTH_SERVICE_REPLICAS=2
HOTEL_SERVICE_REPLICAS=1
ROOM_SERVICE_REPLICAS=2
AVAILABILITY_SERVICE_REPLICAS=2
BOOKING_SERVICE_REPLICAS=2
CUSTOMER_SERVICE_REPLICAS=2
PAYMENT_SERVICE_REPLICAS=2
